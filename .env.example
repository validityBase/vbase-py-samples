# Required for all vBase samples.
VBASE_API_KEY=

# Required only for Amazon S3 samples.
AWS_S3_BUCKET=
# boto3 can also use a shared profile, SSO, or an IAM role.
# AWS_DEFAULT_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Set these to values printed by an S3 producer before running its verifier.
# VBASE_COLLECTION_CID=
# VBASE_OWNER_ADDRESS=

# Required only for Alpaca and Interactive Brokers samples.
# VBASE_COLLECTION_NAME=
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# ALPACA_PAPER=true
# IB_ACCOUNT_ID=
# IB_CA_CERT_PATH=
